{
  "name": "personal-website",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:style": "stylelint \"src/**/*.{scss,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{scss,vue}\" --fix",
    "lint:fsd": "steiger ./src",
    "lint:fsd:watch": "steiger ./src --watch",
    "lint:all": "npm run lint && npm run lint:style && npm run lint:fsd && npm run format:check"
  },
  "dependencies": {
    "eslint": "^10.8.1",
    "nuxt": "^4.5.2",
    "shiki": "^4.4.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@iconify-json/ri": "^1.2.10",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "^2.5.0",
    "@nuxt/image": "^2.1.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.83.0",
    "steiger": "^0.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
